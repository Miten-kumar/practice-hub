{
  "compilerOptions": {
    "module": "esnext",
    "target": "es2024", 
    "strict": true,
    "verbatimModuleSyntax": false,
    "declaration": true,
    "sourceMap": true,
    "declarationMap": true,
    "rootDir": "src",
    "outDir": "dist",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports":true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
  }
}