{
  "name": "test-apis-database",
  "version": "1.0.0",
  "description": "",
  "main": "index.ts",
  "scripts": {
    "test": "jest",
    "dev": "node -r ts-node/register/transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/server.js",
    "seed": "node -r ts-node/register/transpile-only src/seed/seed.ts",
    "migrate": "node-pg-migrate -j ts -m migrations up",
    "migrate:up": "node-pg-migrate -j ts -m migrations up",
    "migrate:down": "node-pg-migrate -j ts -m migrations down",
    "migrate:redo": "node-pg-migrate -j ts -m migrations down && node-pg-migrate -j ts -m migrations up",
    "migrate:create": "node-pg-migrate -j ts -m migrations create"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.4.0",
    "@types/supertest": "^7.2.0",
    "jest": "^30.3.0",
    "node-pg-migrate": "^8.0.4",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
